
ENVVAR
NAME                     VALUE                                 
RUN			 A
RUNPERIOD                21
DSM2MODIFIER             20251230-${RUNPERIOD}${RUN}               #Study name used for DSM2 output                  
DSM2INPUTDIR             ../../common_input                                           
DSM2AGENCY               dwr
VERSIONDATE              200705                                                       
HISTFLOWVERSION          DWR-DMS                                    
HISTSTAGEVERSION         ${HISTFLOWVERSION}
HISTQUALVERSION          DWR-DMS
#runtime                
START_DATE               28Nov2025
START_TIME               0000
FORE_START_DATE		 30Dec2025
FORE_START_TIME		 0000
QUAL_START_DATE          01Dec2025
EC_START_DATE            23Dec2025
PTM_START_DATE           ${QUAL_START_DATE}
END_DATE                 20Jan2026
END_TIME                 2400
QUAL_END_DATE            20Jan2026
WARM_END_DATE            27Dec2025
QUAL_END_TIME            0000
TEMPDIR                  z:/temp                                #Spacious directory for scratch files  
RUNID			 DSM2-${DSM2MODIFIER}
#Input envvars          
STUDYDIR                 .
TSINPUTDIR               ./Data
INPUTDIR		 ./Input
BNDRYINPUT               ${TSINPUTDIR}/hydro.dss
FORECASTINPUT		 ${TSINPUTDIR}/forecast.dss
GATEFILE                 ${TSINPUTDIR}/gates.dss
DICUFILE                 ${TSINPUTDIR}/dicu.dss   #_${VERSIONDATE}.dss
QUALBNDINP               ${TSINPUTDIR}/quality.dss
DICUFILE_ECS             ${TSINPUTDIR}/dicu.dss        #seasonal DICU file for EC                        
DICUFILE_ECE             ${TSINPUTDIR}/dicu.dss #expanded DICU file for EC                                           
DICUFILE_3zones          ${TSINPUTDIR}/dicuwq_3zones.dss
#CLIMATE                  ${TSINPUTDIR}/climate-5years.dss
STOCKTON_FLOW_FILE       constant                               #needed for DO runs, if not available use constant
STOCKTON_EFF_FLOW        0.0                                    #needed for DO runs, if not available use 0.0     
#Output                 
DSM2OUTPUTDIR            ${STUDYDIR}/output
OUTPUTFILE               ${DSM2MODIFIER}.dss
WEEKLYSTAGE              ${STUDYDIR}/output/weeklystage.dss
WEEKLYEC                 ${STUDYDIR}/output/weeklyec.dss
FREEPORTFLOW             ${STUDYDIR}/output/FREEPORTFLOW.dss
AQUEDUCT                 ${STUDYDIR}/output/aqueduct.dss
RMAOUTPUT		 ${STUDYDIR}/output/RMAOUTPUT.dss
SUISUNMARSH		 ${STUDYDIR}/output/SUISUNMARSH.dss
X2OUTPUT                 ${STUDYDIR}/output/X2OUTPUT.dss
VOLTEMP                  ${STUDYDIR}/output/Voltemp.dss
#hydro                  
FLOWPATTERN              ./output/FLOWPATTERN.dss
HYDROOUTDSSFILE          ${DSM2OUTPUTDIR}/${OUTPUTFILE}
HYDROOUTFILE             ${DSM2OUTPUTDIR}/${DSM2MODIFIER}.hof
HYDRORSTFILE             ${DSM2OUTPUTDIR}/${DSM2MODIFIER}.hrf
HYDROTIDEFILE            ${DSM2OUTPUTDIR}/${DSM2MODIFIER}.h5
GATEOUTPUTFILE           ${DSM2OUTPUTDIR}/${OUTPUTFILE}                                                           
#Qual                   
QUALOUTDSSFILE           ${DSM2OUTPUTDIR}/${OUTPUTFILE}
QUALOUTFILE              ${DSM2OUTPUTDIR}/${DSM2MODIFIER}.qof
QUALECRSTFILE            ${DSM2OUTPUTDIR}/qual-Dec3025.qrf
QUALDOCRSTFILE           ${DSM2OUTPUTDIR}/qual_DOC.qrf
QUALALKRSTFILE           ${DSM2OUTPUTDIR}/Qual_Alk.qrf
QUALVOLRSTFILE           ${DSM2OUTPUTDIR}/qual_VOL.qrf
QUALTURRSTFILE           ${DSM2OUTPUTDIR}/qual-tur-Dec3025.qrf
QUALTIDEFILE             ${DSM2OUTPUTDIR}/${DSM2MODIFIER}_ec.h5
FINE_OUT                 15MIN
FINE_OUT_DAY             1DAY                                                                                     
#Jones Tract Levee Break
	#EVENTSINPUT              ${TSINPUTDIR}/events.dss
#PTM
PTMOUTFILE               ${DSM2OUTPUTDIR}/${DSM2MODIFIER}.pof
PTMOUTPUTFILE            ${DSM2OUTPUTDIR}/ptmout.dss
END


